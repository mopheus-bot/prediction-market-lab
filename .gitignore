# Local R2 downloads — `wrangler r2 object get` writes
# the object to ./<key> by default, so investigating R2
# contents (e.g. daily-recap/latest.json) leaves a
# spurious file in the working tree. Never commit.
daily-recap/
models/reversion-*-20*.json
