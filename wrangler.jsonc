/**
 * Wrangler configuration for the Prediction Market Lab Worker.
 *
 * For the full reference:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Before deploying, fill in your own resource identifiers:
 *   - `database_id` under `d1_databases`  → `wrangler d1 create prediction-market-lab`
 *   - `zone_name` under `routes`           → a domain you control, or delete
 *                                            `routes` entirely to use workers.dev
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prediction-market-lab",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"ENVIRONMENT": "production",
		"SERVICE_NAME": "prediction-market-lab",
		// Bootstrap ticker universe. The LiveBot Durable Object can be
		// reconfigured at runtime via POST /api/pm/bot/start with a
		// different set; this is the default before any /start call.
		//
		// The verticals are weather (reversion), economic (reversion),
		// politics (naive) and sports (naive). Each ticker maps to a
		// vertical — see `ticker_verticals` in the LiveBot config.
		"DEFAULT_TICKERS": "KXWARMING-50,KXWARMING-60,KXGDP-Q3,KXPRES-26,KXNFL-CHAMP",
		// The data feed is a 1.5s alarm-driven round-robin REST poll via
		// the kalshi-typescript SDK. DEFAULT_URL is a placeholder — the
		// LiveBot no longer reads it. Kept as a hint for /start callers.
		"DEFAULT_URL": "polling://kalshi-rest",
		// Cloudflare Workers Paid plan billing cycle. Resets monthly on
		// this date. Used by /api/pm/cost to compute "resets in N days".
		"CF_BILLING_CYCLE_START": "2026-08-08"
	},
	// D1 database — bound at runtime as `env.DB`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "prediction-market-lab",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "migrations"
		}
	],
	// R2 bucket — bound at runtime as `env.BUCKET`. Holds model
	// artifacts, the market-data archive and generated reports.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "prediction-market-lab"
		}
	],
	// Durable Objects.
	//
	// LIVE_BOT — the trading bot. One instance per user, addressed by
	// `idFromName('user:${userId}')`. The class lives in
	// `src/durable-objects/LiveBot.ts`.
	//
	// SHADOW_BOT — the paper-trading shadow. One instance per user and
	// candidate model version, addressed by
	// `idFromName('user:${userId}:shadow:${modelVersion}')`.
	"durable_objects": {
		"bindings": [
			{
				"name": "LIVE_BOT",
				"class_name": "LiveBot"
			},
			{
				"name": "SHADOW_BOT",
				"class_name": "ShadowBot"
			}
		]
	},
	// Required for the `cloudflare:workers` DurableObject class export.
	// Replaced on every `wrangler deploy`.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["LiveBot", "ShadowBot"]
		}
	],
	// Custom-domain routes. A single catch-all so /, /health, /pm/* and
	// /api/pm/* all reach the Worker (the Worker routes internally).
	// Cloudflare auto-creates the DNS records on deploy.
	//
	// Replace the zone name with a domain you control, or remove this
	// block entirely to serve from workers.dev.
	"routes": [
		{ "pattern": "/*", "zone_name": "example.com" }
	],
	// Cron Triggers. Each expression fires a scheduled event; the
	// Worker's `scheduled` handler dispatches by expression to a job.
	// The expressions must match CRON_TABLE in src/cron/dispatcher.ts.
	"triggers": {
		"crons": [
			"*/15 * * * *",  // scan        — every 15 min
			"5,20,35,50 * * * *",  // research  — every 15 min, offset 5 min. Polls Kalshi live markets and snapshots is_live markets to D1.
			"0 */6 * * *",   // news        — every 6 hours (00/06/12/18 UTC)
			"0 6 * * *",     // daily       — 06:00 UTC daily
			"30 5 * * *",    // auto_pilot  — 05:30 UTC daily (default off)
			"0 7 * * *",     // heartbeat   — 07:00 UTC daily (passive health check; alerts on failure)
			"30 */6 * * *",  // leads       — every 6 hours, offset 30 min. LLM-driven ticker universe add+drop. Offset by 30 min from news so the LLM has fresh news data to weigh against. The expression is deliberately distinct from `news` so jobForCron can dispatch correctly.
			"0 * * * *", // llm_opinions — every hour. Originally every 2 min, which cost ~$13/day (10,266 calls, 8.3M input / 4.0M output tokens over 3.7 days) for an 89% hold rate. Cadence reduced to once per hour; the in-cron staleness filter (skip if the price has not moved since the last verdict) and the two-sided-quote filter (skip one-sided parlays) cut calls by a further ~80%. Verdicts have a 1h soft TTL, so hourly refreshes match the bot's poll-cycle design.
			"0 0 * * SUN",   // train       — 00:00 UTC Sunday
			"0 1 * * SUN"    // backtest    — 01:00 UTC Sunday
		]
	}
}
