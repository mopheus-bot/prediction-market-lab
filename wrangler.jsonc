/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pm-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"ENVIRONMENT": "production",
		"SERVICE_NAME": "pm-bot"
	},
	// D1 database — bound at runtime as `env.DB`.
	// database_id filled in after `wrangler d1 create pm-bot-prod`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pm-bot-prod",
			"database_id": "cd54a509-f2e2-4f6f-97a5-a53afa6c0a36",
			"migrations_dir": "migrations"
		}
	],
	// R2 bucket — bound at runtime as `env.BUCKET`.
	// Created via `wrangler r2 bucket create pm-bot`.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "pm-bot"
		}
	],
	// Custom-domain routes —  is a CF-proxied subdomain
	// under the  zone. CF auto-creates the DNS records on deploy.
	"routes": [
		{ "pattern": "/pm/*", "zone_name": "" },
		{ "pattern": "/api/pm/*", "zone_name": "" }
	]
}
