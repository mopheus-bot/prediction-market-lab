/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pm-bot",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"ENVIRONMENT": "production",
		"SERVICE_NAME": "pm-bot",
		// Default paper-trading universe (comma-separated tickers). The
		// LiveBot DO can be reconfigured via POST /start with a different
		// set; this is the bootstrap default before any /start call.
		"DEFAULT_TICKERS": "KXWARMING-50",
		// Default WS URL. Demo by default; the /start command can flip
		// to production with `{"url": "wss://external-api-ws.kalshi.com/..."}`.
		"DEFAULT_URL": "wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2"
	},
	// D1 database — bound at runtime as `env.DB`.
	// database_id filled in after `wrangler d1 create pm-bot-prod`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pm-bot-prod",
			"database_id": "cd54a509-f2e2-4f6f-97a5-a53afa6c0a36",
			"migrations_dir": "migrations"
		}
	],
	// R2 bucket — bound at runtime as `env.BUCKET`.
	// Created via `wrangler r2 bucket create pm-bot`.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "pm-bot"
		}
	],
	// Durable Object — the live bot. Chunk 3 introduces this. There is
	// ONE live-bot DO per user, addressed by `idFromName('user:${userId}')`.
	// The class lives in `src/durable-objects/LiveBot.ts`.
	//
	// Chunk 8 adds the shadow bot, addressed by
	// `idFromName('user:${userId}:shadow:${modelVersion}')`. Each
	// candidate model gets its own shadow DO.
	"durable_objects": {
		"bindings": [
			{
				"name": "LIVE_BOT",
				"class_name": "LiveBot"
			},
			{
				"name": "SHADOW_BOT",
				"class_name": "ShadowBot"
			}
		]
	},
	// Required for the `cloudflare:workers` DurableObject class export.
	// Replaced on every `wrangler deploy`.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["LiveBot", "ShadowBot"]
		}
	],
	// Custom-domain routes —  is a CF-proxied subdomain
	// under the  zone. CF auto-creates the DNS records on deploy.
	// Single catch-all so /, /health, /pm/*, /api/pm/* all reach the Worker
	// (the Worker routes internally).
	"routes": [
		{ "pattern": "/*", "zone_name": "" }
	],
	// Cron Triggers (chunk 5). Each expression fires a scheduled
	// event; the Worker's `scheduled` handler dispatches by the
	// expression to one of the 4 jobs (scan / news / daily / train).
	// The expressions must match CRON_TABLE in src/cron/dispatcher.ts.
	"triggers": {
		"crons": [
			"*/15 * * * *",  // scan     — every 15 min
			"0 */6 * * *",   // news     — every 6 hours
			"0 6 * * *",     // daily    — 06:00 UTC daily
			"0 0 * * 0"      // train    — 00:00 UTC Sunday
		]
	}
}
