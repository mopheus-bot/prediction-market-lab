# Prediction Market Lab — environment variables
#
# Every value here is a placeholder. Copy this file to `.dev.vars` for local
# development (`wrangler dev` reads `.dev.vars`), or set each one as a
# Worker secret with `wrangler secret put <NAME>` before deploying.
#
#   cp .env.example .dev.vars
#
# `.dev.vars` is gitignored. Never commit real credentials.

# ─── Kalshi credentials ────────────────────────────────────────────────
# Required for anything private: portfolio, orders, WebSocket handshake.
#
# KALSHI_DEMO_* points at the Kalshi sandbox (https://demo.kalshi.co) and is
# what you should use while developing. KALSHI_PROD_* is the live exchange —
# leave it unset until you mean it.
#
# The private key must be PKCS#8. Kalshi issues PKCS#1
# (`BEGIN RSA PRIVATE KEY`); convert once with:
#   openssl pkcs8 -topk8 -in kalshi-demo.pem -out kalshi-demo-pkcs8.pem
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY=
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY=

# Override the API base URL. Leave unset for the live exchange; the demo
# environment is selected by the presence of the KALSHI_DEMO_* pair.
# KALSHI_BASE_URL=https://demo-api.kalshi.co

# ─── Notifications ─────────────────────────────────────────────────────
# Telegram is the primary operator channel. Both values are required for the
# bridge to report itself as configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── LLM ───────────────────────────────────────────────────────────────
# The LLM is used as a signal source (a directional opinion per market) and
# as a ticker-universe scout. Both are optional; without them the bot falls
# back to the naive and reversion strategies only.
MMX_API_KEY=
# MMX_BASE_URL=
# MMX_MODEL=

# ─── Cloudflare API ────────────────────────────────────────────────────
# Read-only token used by /api/pm/analytics to pull Workers Analytics.
# Scope it to Workers Analytics:Read for the account named in CF_ACCOUNT_TAG.
CF_API_TOKEN=
CF_ACCOUNT_TAG=

# ─── Tuning (optional; sensible defaults are compiled in) ──────────────
# Auto-pilot promotes the bot to real trading once the paper record clears
# these thresholds. All four must be satisfied.
AUTO_PILOT_ENABLED=false
AUTO_PILOT_MIN_TRADES=50
AUTO_PILOT_MIN_SHARPE=1.5
AUTO_PILOT_MIN_DAYS=14
AUTO_PILOT_ANNUALIZATION_DAYS=365

# Backtest lookback window, in days.
BACKTEST_WINDOW_DAYS=30

# Per-vertical risk overrides, as JSON. See src/risk/config.ts for the shape.
# RISK_CONFIG_OVERRIDE={"sports":{"max_positions":1}}
