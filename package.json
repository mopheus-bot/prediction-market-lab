{
  "name": "prediction-market-lab",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Quant research platform for prediction-market trading — Cloudflare Workers + Durable Objects + D1 + R2, with a multi-vertical ML signal pipeline.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "d1:migrate:local": "wrangler d1 migrations apply prediction-market-lab --local",
    "d1:migrate:prod": "wrangler d1 migrations apply prediction-market-lab --remote",
    "d1:shell:local": "wrangler d1 execute prediction-market-lab --local --command",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "auth:vectors": "python3 scripts/gen-auth-vectors.py",
    "models:upload": "for v in weather economic politics sports; do npx wrangler r2 object put prediction-market-lab/models/reversion-${v}-v1.json --file models/reversion-${v}-v1.json; done"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "kalshi-typescript": "^3.26.0"
  }
}
